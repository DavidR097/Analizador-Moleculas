<UserControl x:Class="AnalizadorMoleculas.Views.LaboratorioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="420"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="360"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelContenido}" Padding="20,14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Laboratorio:" Foreground="{StaticResource TextoSecundario}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding LaboratoriosDisponibles}"
                              SelectedItem="{Binding LaboratorioSeleccionado}"
                              DisplayMemberPath="NombreDisplay"
                              TextSearch.TextPath="Nombre"
                              IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                              Height="36" Background="#14142A" Foreground="{StaticResource TextoPrimario}" BorderBrush="{StaticResource BorderSutil}"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#0D1F15" BorderBrush="#2A4A35" BorderThickness="1" CornerRadius="6" Padding="10,5">
                            <TextBlock Foreground="{StaticResource VerdeOk}" FontSize="10" FontFamily="Consolas" FontWeight="Bold">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} laboratorios cargados">
                                        <Binding Path="LaboratoriosDisponibles.Count"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="PRODUCTOS" Foreground="{StaticResource TextoSecundario}" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                        <TextBlock Text="{Binding ProductosCount}" Foreground="White" FontSize="24" FontWeight="Black" Margin="0,6,0,0"/>
                        <TextBlock Text="packs distintos" Foreground="{StaticResource TextoMuted}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="PX TOTAL" Foreground="{StaticResource TextoSecundario}" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                        <TextBlock Text="{Binding TotalPX, StringFormat={}{0:N0}}" Foreground="{StaticResource AcentoMagenta}" FontSize="24" FontWeight="Black" Margin="0,6,0,0"/>
                        <TextBlock Text="recetado" Foreground="{StaticResource TextoMuted}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="UN TOTAL" Foreground="{StaticResource TextoSecundario}" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                        <TextBlock Text="{Binding TotalUN, StringFormat={}{0:N0}}" Foreground="{StaticResource AcentoCian}" FontSize="24" FontWeight="Black" Margin="0,6,0,0"/>
                        <TextBlock Text="vendido" Foreground="{StaticResource TextoMuted}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="CONVERSIÓN" Foreground="{StaticResource TextoSecundario}" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                        <TextBlock Text="{Binding ConversionLab}" Foreground="{StaticResource VerdeOk}" FontSize="20" FontWeight="Black" Margin="0,6,0,0"/>
                        <TextBlock Text="UN / PX del laboratorio" Foreground="{StaticResource TextoMuted}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="MOLÉCULA ESTRELLA" Foreground="{StaticResource TextoSecundario}" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                        <TextBlock Text="{Binding MoleculaEstrella}" Foreground="White" FontSize="18" FontWeight="Black" Margin="0,6,0,0"/>
                        <TextBlock Text="ATC de mayor peso" Foreground="{StaticResource TextoMuted}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="5" Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="PARTICIPACIÓN MERCADO" Foreground="{StaticResource TextoSecundario}" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                        <TextBlock Text="{Binding ParticipacionMercadoLab, StringFormat={}{0:N1}%}" Foreground="{StaticResource AcentoMagenta}" FontSize="24" FontWeight="Black" Margin="0,6,0,0"/>
                        <TextBlock Text="sobre el PX total cargado" Foreground="{StaticResource TextoMuted}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelContenido}" Margin="0,0,6,0" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Top 8 packs/productos (PX vs UN)" Foreground="{StaticResource TextoPrimario}" FontSize="13" FontWeight="Bold" Margin="4,0,0,8"/>
                        <lvc:CartesianChart Grid.Row="1"
                                            Series="{Binding SeriesLab}"
                                            XAxes="{Binding XAxesLab}"
                                            YAxes="{Binding YAxesLab}"
                                            LegendPosition="Top"
                                            Background="#FF10101C"/>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelContenido}" Margin="6,0,0,0" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Competidores en su molécula estrella" Foreground="{StaticResource TextoPrimario}" FontSize="13" FontWeight="Bold" Margin="4,0,0,8"/>
                        <lvc:PieChart Grid.Row="1" Series="{Binding SeriesCompetidoresLab}" Background="#FF10101C" LegendPosition="Right"/>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Grid.Row="3" Text="Ranking de packs/productos del laboratorio" Foreground="{StaticResource TextoPrimario}" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelContenido}" Padding="0" Margin="0,0,6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#0D0D1E" Padding="16,10" BorderBrush="{StaticResource BorderSutil}" BorderThickness="0,0,0,1">
                            <TextBlock Text="🔬 Ranking por pack/producto" Foreground="{StaticResource AcentoMagenta}" FontSize="11" FontFamily="Consolas" FontWeight="SemiBold"/>
                        </Border>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding RankingProductosLab}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  Background="Transparent" BorderThickness="0"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Pack / Producto" Binding="{Binding Producto}" Width="2*"/>
                                <DataGridTextColumn Header="ATC" Binding="{Binding Atc}" Width="*"/>
                                <DataGridTextColumn Header="PX" Binding="{Binding PX, StringFormat=N0}" Width="*"/>
                                <DataGridTextColumn Header="UN" Binding="{Binding UN, StringFormat=N0}" Width="*"/>
                                <DataGridTextColumn Header="% PX del Lab" Binding="{Binding ParticipacionPX, StringFormat={}{0:N1}%}" Width="*"/>
                                <DataGridTextColumn Header="% UN del Lab" Binding="{Binding ParticipacionUN, StringFormat={}{0:N1}%}" Width="*"/>
                                <DataGridTextColumn Header="Conversión" Binding="{Binding ConversionDisplay}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelContenido}" Padding="0" Margin="6,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#0D0D1E" Padding="16,10" BorderBrush="{StaticResource BorderSutil}" BorderThickness="0,0,0,1">
                            <TextBlock Text="⚔️ Competidores directos" Foreground="{StaticResource AcentoCian}" FontSize="11" FontFamily="Consolas" FontWeight="SemiBold"/>
                        </Border>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding CompetidoresLab}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  Background="Transparent" BorderThickness="0"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Laboratorio" Binding="{Binding Nombre}" Width="2*"/>
                                <DataGridTextColumn Header="PX" Binding="{Binding PX, StringFormat=N0}" Width="*"/>
                                <DataGridTextColumn Header="UN" Binding="{Binding UN, StringFormat=N0}" Width="*"/>
                                <DataGridTextColumn Header="Part. %" Binding="{Binding Participacion, StringFormat={}{0:N1}%}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
