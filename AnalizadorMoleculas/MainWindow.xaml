<mah:MetroWindow x:Class="AnalizadorMoleculas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:views="clr-namespace:AnalizadorMoleculas.Views"
        xmlns:vm="clr-namespace:AnalizadorMoleculas.ViewModels"
        mc:Ignorable="d"
        Title="Farmacol - Molecular Data Intelligence System"
        Height="800" Width="1366"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#07070F"
        WindowTitleBrush="#0B0B16"
        NonActiveWindowTitleBrush="#07070F"
        TitleForeground="#E8E8F0"
        BorderBrush="#1E1E35"
        GlowBrush="#7209B7">

    <mah:MetroWindow.DataContext>
        <vm:MainViewModel/>
    </mah:MetroWindow.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderSutil}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,28,20,24">
                    <TextBlock Text="FARMACOL" Foreground="White" FontSize="18" FontWeight="Black" FontFamily="Segoe UI"/>
                    <Border Margin="0,6,0,0" Height="1" Background="{StaticResource BorderSutil}"/>
                    <TextBlock Text="INTELLIGENCE MODULE" Foreground="{StaticResource AcentoMagenta}" FontSize="9" FontWeight="Bold" FontFamily="Consolas" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock Text="PRINCIPAL" Foreground="{StaticResource TextoMuted}" FontSize="9" FontWeight="Bold" FontFamily="Consolas" Margin="26,0,0,8"/>

                    <RadioButton Style="{StaticResource NavItem}" IsChecked="True" Command="{Binding NavigateCommand}" CommandParameter="hub" x:Name="NavHub">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏠" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Home" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItem}" IsChecked="True" Command="{Binding NavigateCommand}" CommandParameter="espejo" x:Name="NavEspejo">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⇌" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Comparación Espejo" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="archivos" x:Name="NavArchivos">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Archivos de Auditoría" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="metricas" x:Name="NavMetricas">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Métricas y Gráficos" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="molecula" x:Name="NavMolecula">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔬" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Análisis por Molécula" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="brechas" x:Name="NavBrechas">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Brechas de Información" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItem}" Command="{Binding NavigateCommand}" CommandParameter="sqlite" x:Name="NavSqlite">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Base de Datos Local" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <Border Height="1" Background="{StaticResource BorderSutil}" Margin="20,16"/>

                    <TextBlock Text="ACCIONES" Foreground="{StaticResource TextoMuted}" FontSize="9" FontWeight="Bold" FontFamily="Consolas" Margin="26,0,0,8"/>

                    <Button Style="{StaticResource BtnPrimario}" Content="▲  Cargar Excel" Command="{Binding CargarCommand}" Margin="14,4" Height="38"/>
                    <Button Style="{StaticResource BtnSecundario}" Content="↓  Exportar Resultado" Command="{Binding ExportarCommand}" Margin="14,4" Height="38"/>
                </StackPanel>

                <Border Grid.Row="2" BorderBrush="{StaticResource BorderSutil}" BorderThickness="0,1,0,0" Padding="20,14">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextoSecundario}" FontSize="10" FontFamily="Consolas" TextWrapping="Wrap" MaxWidth="180"/>
                        <TextBlock Text="v2.0 · SENA Apprentice" Foreground="{StaticResource TextoMuted}" FontSize="9" FontFamily="Consolas" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource BgBase}">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#09091A" BorderBrush="{StaticResource BorderSutil}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TituloVista" Text="Análisis Comparativo" Foreground="{StaticResource TextoPrimario}" FontSize="14" FontWeight="SemiBold"/>
                        <Border Background="#1A0A2E" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LIVE" Foreground="{StaticResource AcentoMagenta}" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSutil}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <SolidColorBrush x:Name="PuntoCarga" Color="#3DDC84"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="Motor activo" Foreground="{StaticResource TextoSecundario}" FontSize="11" FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="20,20,14,20">
                <Grid>
                    <views:HubView Visibility="{Binding VistaActual, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=hub}"/>
                    <views:EspejoView Visibility="{Binding VistaActual, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=espejo}"/>
                    <views:ArchivosView Visibility="{Binding VistaActual, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=archivos}"/>
                    <views:MetricasView Visibility="{Binding VistaActual, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=metricas}"/>
                    <views:MoleculaView Visibility="{Binding VistaActual, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=molecula}"/>
                    <views:BrechasView Visibility="{Binding VistaActual, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=brechas}"/>
                    <views:SqliteView Visibility="{Binding VistaActual, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=sqlite}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</mah:MetroWindow>